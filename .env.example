# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI Service Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Alternative: ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Configuration
# For development (SQLite):
DATABASE_URL=sqlite:///./financialassist.db

# For production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/financialassist

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Performance Settings
AI_RESPONSE_TIMEOUT=3
BOT_RESPONSE_TIMEOUT=2
CACHE_TTL=300
